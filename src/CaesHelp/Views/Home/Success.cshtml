@{
    ViewBag.Title = "Success";
}
<section class="ticket-success" aria-labelledby="ticket-success-title">
    <canvas class="ticket-success__confetti" aria-hidden="true" hidden></canvas>
    <div class="ticket-success__celebration" aria-hidden="true">
        <div class="ticket-success__check">
            <svg viewBox="0 0 48 48" width="48" height="48" fill="none" focusable="false">
                <path d="M13 24.5 21 32l15-16" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </div>
    </div>

    <p class="ticket-success__eyebrow">Request received</p>
    <h2 id="ticket-success-title">Help ticket submitted.</h2>
    <p class="ticket-success__intro">Thanks for reaching out to CAES Help.</p>

    <div class="ticket-success__next">
        <svg viewBox="0 0 24 24" width="28" height="28" fill="none" aria-hidden="true" focusable="false">
            <rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.5" />
            <path d="m4 7 8 6 8-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <div>
            <h3>Keep an eye on your inbox</h3>
            <p>You should receive a confirmation email within <strong>5–10 minutes.</strong></p>
        </div>
    </div>

    <a asp-action="Index" class="ticket-success__action">
        Submit another ticket
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" aria-hidden="true" focusable="false">
            <path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
    </a>
    <p class="ticket-success__footnote">You're all set. You can close this page.</p>
</section>

@section Scripts
{
    <script>
        (() => {
            const canvas = document.querySelector('.ticket-success__confetti');
            const check = document.querySelector('.ticket-success__check');
            const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
            if (!canvas || !check || reducedMotion.matches || document.hidden) return;

            const context = canvas.getContext('2d');
            if (!context) return;

            canvas.hidden = false;
            const { width, height } = canvas.getBoundingClientRect();
            if (!width || !height) {
                canvas.hidden = true;
                return;
            }

            const pixelRatio = Math.min(window.devicePixelRatio || 1, 2);
            canvas.width = Math.round(width * pixelRatio);
            canvas.height = Math.round(height * pixelRatio);
            context.scale(pixelRatio, pixelRatio);

            const badge = check.getBoundingClientRect();
            const originX = Math.max(24, Math.min(width - 24, badge.left + badge.width / 2));
            const originY = Math.max(40, Math.min(height * 0.65, badge.top + badge.height / 2));
            const spread = Math.min(width * 0.3, 240);
            const scale = Math.min(width / 700, 1);
            const colors = ['#ffbf00', '#1d4a83', '#00b5e2', '#d2ac39', '#c6007e', '#ffe7a3'];
            const particles = [];
            const bursts = [
                { delay: 120, x: originX, y: originY, angle: -Math.PI / 2, arc: Math.PI * 1.5, count: 100 },
                { delay: 400, x: originX - spread, y: originY + 80, angle: -Math.PI / 3, arc: Math.PI / 2, count: 80 },
                { delay: 650, x: originX + spread, y: originY + 80, angle: -Math.PI * 2 / 3, arc: Math.PI / 2, count: 80 }
            ];

            function burst(options) {
                const count = Math.round(options.count * Math.max(0.65, scale));
                for (let i = 0; i < count; i++) {
                    const angle = options.angle + (Math.random() - 0.5) * options.arc;
                    const speed = (420 + Math.random() * 420) * Math.max(0.7, scale);
                    particles.push({
                        x: options.x,
                        y: options.y,
                        vx: Math.cos(angle) * speed,
                        vy: Math.sin(angle) * speed,
                        size: 6 + Math.random() * 6,
                        rotation: Math.random() * Math.PI,
                        spin: (Math.random() - 0.5) * 14,
                        flutter: Math.random() * Math.PI * 2,
                        color: colors[Math.floor(Math.random() * colors.length)],
                        round: i % 5 === 0,
                        age: 0,
                        lifetime: 2.6 + Math.random() * 0.8
                    });
                }
            }

            let frame;
            let started;
            let previous;
            let nextBurst = 0;
            let stopped = false;

            function stop() {
                stopped = true;
                window.cancelAnimationFrame(frame);
                canvas.remove();
                window.removeEventListener('resize', stop);
                window.removeEventListener('pagehide', stop);
                document.removeEventListener('visibilitychange', onVisibilityChange);
                reducedMotion.removeEventListener('change', stop);
            }

            function onVisibilityChange() {
                if (document.hidden) stop();
            }

            function animate(now) {
                if (stopped) return;
                if (started === undefined) started = previous = now;
                const elapsed = now - started;
                const delta = Math.min((now - previous) / 1000, 0.04);
                previous = now;
                if (elapsed > 4400) {
                    stop();
                    return;
                }

                while (nextBurst < bursts.length && elapsed >= bursts[nextBurst].delay) {
                    burst(bursts[nextBurst++]);
                }

                context.clearRect(0, 0, width, height);
                const drag = Math.exp(-1.3 * delta);
                for (let i = particles.length - 1; i >= 0; i--) {
                    const particle = particles[i];
                    particle.age += delta;
                    if (particle.age >= particle.lifetime || particle.y > height + 24) {
                        particles.splice(i, 1);
                        continue;
                    }

                    particle.vx *= drag;
                    particle.vy = particle.vy * drag + 620 * delta;
                    particle.x += particle.vx * delta;
                    particle.y += particle.vy * delta;
                    particle.rotation += particle.spin * delta;
                    const tumble = Math.max(0.2, Math.abs(Math.cos(particle.age * 10 + particle.flutter)));

                    context.save();
                    context.translate(particle.x, particle.y);
                    context.rotate(particle.rotation);
                    context.scale(1, tumble);
                    context.globalAlpha = Math.min(1, (particle.lifetime - particle.age) / 0.7);
                    context.fillStyle = particle.color;
                    if (particle.round) {
                        context.beginPath();
                        context.arc(0, 0, particle.size / 2, 0, Math.PI * 2);
                        context.fill();
                    } else {
                        context.fillRect(-particle.size / 2, -particle.size / 3, particle.size, particle.size * 0.65);
                    }
                    context.restore();
                }

                if (nextBurst === bursts.length && particles.length === 0) stop();
                else frame = window.requestAnimationFrame(animate);
            }

            window.addEventListener('resize', stop);
            window.addEventListener('pagehide', stop);
            document.addEventListener('visibilitychange', onVisibilityChange);
            reducedMotion.addEventListener('change', stop);
            frame = window.requestAnimationFrame(animate);
        })();
    </script>
}
